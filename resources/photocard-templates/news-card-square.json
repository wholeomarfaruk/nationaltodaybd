{
    "name": "News Card Square",
    "slug": "news-card-square",
    "description": "Square social media news card with featured image, centered logo and large Bengali title",

    "canvas": {
        "width": 1080,
        "height": 1080,
        "background": "#f1d2c3"
    },

    "required_fields": ["title", "logo", "date", "image"],
    "optional_fields": ["caption", "category"],

    "date_format": "j M, Y",
    "language": "bn",

    "elements": [
        {
            "type": "image",
            "field": "image",
            "x": 0,
            "y": 0,
            "w": 1080,
            "h": 610,
            "fit": "cover"
        },

        {
            "type": "gradient",
            "x": 0,
            "y": 430,
            "w": 1080,
            "h": 180,
            "from": "#00000000",
            "to": "#000000aa",
            "direction": "vertical"
        },

        {
            "type": "image",
            "field": "logo",
            "x": 370,
            "y": 530,
            "w": 340,
            "h": 150,
            "fit": "contain"
        },

        {
            "type": "text",
            "field": "title",
            "x": 40,
            "y": 780,
            "max_width": 1000,
            "font": "fonts/NotoSansBengali-Bold.ttf",
            "size": 60,
            "color": "#004da8",
            "align": "center",
            "line_height": 88,
            "max_lines": 3,
            "text_shadow": {
                "x": 2,
                "y": 2,
                "blur": 4,
                "color": "#000000",
                "opacity": 0.35
            }
        },

        {
            "type": "rectangle",
            "x": 0,
            "y": 1000,
            "w": 1080,
            "h": 80,
            "fill": "#ffffff"
        },

        {
            "type": "text",
            "value": "{category} | {date}",
            "x": 30,
            "y": 1050,
            "max_width": 400,
            "font": "fonts/NotoSansBengali-Regular.ttf",
            "size": 28,
            "color": "#000000",
            "align": "left"
        },

        {
            "type": "text",
            "value": "nationaltodaybd.com",
            "x": 750,
            "y": 1050,
            "max_width": 300,
            "font": "fonts/NotoSansBengali-Regular.ttf",
            "size": 28,
            "color": "#000000",
            "align": "right"
        },

        {
            "type": "badge",
            "center_x": true,
            "y": 968,
            "w": 240,
            "h": 54,
            "radius": 27,
            "fill": "#ff0000",
            "value": "বিস্তারিত কমেন্টে",
            "font": "fonts/NotoSansBengali-Bold.ttf",
            "size": 24,
            "color": "#ffffff",
            "shadow": {
                "x": 0,
                "y": 3,
                "blur": 6,
                "color": "#000000",
                "opacity": 0.3
            }
        }
    ]
}
