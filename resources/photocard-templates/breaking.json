{
  "name": "Breaking News Template",
  "slug": "breaking",
  "description": "Bold breaking news card with featured image and prominent title",
  "canvas": {
    "width": 1080,
    "height": 1080,
    "background": "#0f172a"
  },
  "required_fields": [
    "title",
    "logo",
    "date"
  ],
  "optional_fields": [
    "caption",
    "category",
    "image"
  ],
  "branding": {
    "logo_position": {
      "x": 40,
      "y": 40,
      "w": 120,
      "h": 120
    },
    "footer_text": "nationaltodaybd.com",
    "watermark": true
  },
  "fonts": {
    "title": {
      "file": "fonts/NotoSansBengali-Bold.ttf",
      "size": 64,
      "color": "#ffffff"
    },
    "caption": {
      "file": "fonts/NotoSansBengali-Regular.ttf",
      "size": 34,
      "color": "#cbd5e1"
    },
    "footer": {
      "file": "fonts/NotoSansBengali-Regular.ttf",
      "size": 24,
      "color": "#94a3b8"
    }
  },
  "layout": {
    "title": {
      "x": 60,
      "y": 200,
      "max_width": 960
    },
    "caption": {
      "x": 60,
      "y": 320,
      "max_width": 960
    },
    "image": {
      "x": 0,
      "y": 500,
      "w": 1080,
      "h": 580
    },
    "category": {
      "x": 60,
      "y": 130,
      "max_width": 200
    },
    "footer": {
      "x": 60,
      "y": 1020,
      "max_width": 960
    }
  },
  "date_format": "d M Y",
  "language": "bn"
}
